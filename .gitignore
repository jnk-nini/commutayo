# Raw OSM ingestion cache -- large, regenerable, not source
data/

# Dead end: hand-built SQL batches from before SUPABASE_SERVICE_ROLE_KEY existed. Generated but
# never applied (the real write went through scripts/push-ingest-output.ts), 4.4MB, and
# regenerable at any time by running generate-sql.mjs against the JSON beside it.
scripts/.ingest-output/sql_batches/

